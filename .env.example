# Kopie als .env anlegen (setup.sh macht das) und anpassen.
# .env ist in .gitignore und gehoert NICHT ins Repository.

# --- Betriebsart ----------------------------------------------------------
# Heimnetz ueber HTTP ist der Standard. Fuer die Variante mit Traefik und
# Let's Encrypt (fuer Fortgeschrittene) hier docker-compose.yml eintragen.
COMPOSE_FILE=docker-compose.quick.yml

# --- Images ---------------------------------------------------------------
# Praefix der von der CI gebauten Images. Die GitHub Action legt sie unter
# ghcr.io/<account>/<repo>-api und -web ab, jeweils klein geschrieben.
WQ_IMAGE_PREFIX=ghcr.io/dein-account/wordquest

# Welcher Stand gezogen wird. "master" ist der jeweils letzte Build des
# Hauptbranches; fuer einen festen Stand ein Git-Tag eintragen (z. B. 0.1.0).
WQ_VERSION=master

# --- Betrieb --------------------------------------------------------------
# Oeffentlich erreichbarer Hostname der Instanz (nur docker-compose.yml).
WQ_HOST=wordquest.example.de

# Zeitzone der Instanz. Bestimmt, wann "morgen" anfaengt - die Faelligkeiten
# werden auf 4 Uhr Ortszeit normalisiert.
WQ_TIMEZONE=Europe/Berlin

# Demo-Daten beim ersten Start anlegen (Elternkonto, Kind, Beispielset).
# Nur fuer Entwicklung und Tests.
WQ_SEED_DEMO_DATA=false

# --- TLS / Let's Encrypt (nur docker-compose.yml) -------------------------
WQ_ACME_EMAIL=du@example.de
# Siehe https://doc.traefik.io/traefik/https/acme/#providers
WQ_ACME_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=
