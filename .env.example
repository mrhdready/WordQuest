# Kopie als .env anlegen (setup.sh macht das) und anpassen.
# .env ist in .gitignore und gehoert NICHT ins Repository.

# --- Betriebsart ----------------------------------------------------------
# Heimnetz ueber HTTP mit docker-compose.quick.yml.
COMPOSE_FILE=docker-compose.quick.yml

# --- Images ---------------------------------------------------------------
# Praefix der Images: das veroeffentlichte WordQuest. Aendern muss das nur,
# wer eigene Images baut (Fork); setup.sh fragt danach, Enter uebernimmt ihn.
WQ_IMAGE_PREFIX=ghcr.io/mrhdready/wordquest

# Welcher Stand gezogen wird. Ein fester Stand, der mit dem Release-Paket
# kommt; upgrade.sh traegt ihn ein. Von Hand nur fuer den Weg zurueck nach
# einem gescheiterten Update aendern (Documentation/Installation.md, Abschnitt
# Update).
WQ_VERSION=1.0.1

# --- Betrieb --------------------------------------------------------------
# Zeitzone der Instanz. Bestimmt, wann "morgen" anfaengt - die Faelligkeiten
# werden auf 4 Uhr Ortszeit normalisiert.
WQ_TIMEZONE=Europe/Berlin

# Demo-Daten beim ersten Start anlegen (Elternkonto, Kind, Beispielset).
# Nur fuer Entwicklung und Tests.
WQ_SEED_DEMO_DATA=false
